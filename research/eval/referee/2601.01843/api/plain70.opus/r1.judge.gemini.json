  },
  {
   "concern": "C17",
   "verdict": "raised",
   "quote": "The multigap interpretation is not treated coherently. Different bands in a single IR should be described within a multiband BdG model, not as independent incoherent junctions.",
   "fixed_in_v1": false
  },
  {
   "concern": "C1",
