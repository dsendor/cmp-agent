# Copy to .env in the repository root and fill in. .env is gitignored: never commit it.
# Load it for a command with:  set -a; . ./.env; set +a
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# The eval harness (research/eval/api). Claude reviews run as Claude Code subagents where possible;
# this key is for the API harness only.
CMP_EVAL_ANTHROPIC_KEY=
# Gemini: the second, non-Claude judge
GEMINI_API_KEY=
# Backups (research/corpus/backup.py): a write token and a private dataset repo, user/name
HF_TOKEN=
HF_DATASET_REPO=
